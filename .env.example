# PAYVRA environment. Copy to .env and fill in. NEVER commit .env.
# DATABASE_URL is the ONLY switch between local Docker Postgres and Neon.

# --- Core ---
ENV=dev                         # dev | demo | prod
LOG_LEVEL=INFO

# --- Database (SQLAlchemy 2.0 + psycopg v3 driver) ---
# Local docker-compose Postgres 16 (published on host port 5433 to dodge a native Postgres on 5432):
DATABASE_URL=postgresql+psycopg://payvra:payvra@localhost:5433/payvra
# Neon (pooled) example — note sslmode and the -pooler host; verify by end of Phase 1:
# DATABASE_URL=postgresql+psycopg://user:pass@ep-xxx-pooler.region.aws.neon.tech/payvra?sslmode=require

# --- Scheduler (ADR-007: APScheduler in-process, Postgres job store) ---
SCHEDULER_HEARTBEAT_SECONDS=60

# --- Agent / LLM (LiteLLM abstraction — see ADR-003). Off by default in Phase 0. ---
LLM_ENABLED=false
REPLY_CONFIDENCE_THRESHOLD=0.70
GROQ_API_KEY=dummy-groq-key
GEMINI_API_KEY=dummy-gemini-key
OPENROUTER_API_KEY=dummy-openrouter-key

# --- Razorpay (test mode only — ADR-006). Unused until Phase 4. ---
RAZORPAY_KEY_ID=rzp_test_dummy
RAZORPAY_KEY_SECRET=dummy-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=dummy-webhook-secret

# --- Delivery providers. Unused until Phase 4/5. ---
RESEND_API_KEY=dummy-resend-key
MSG91_API_KEY=dummy-msg91-key
WHATSAPP_TOKEN=dummy-whatsapp-token

# --- App secrets ---
# Fernet key used to encrypt merchant Razorpay secrets at rest (*_enc columns).
APP_ENCRYPTION_KEY=dummy-32-byte-base64-fernet-key=
